# ── Claude Code ───────────────────────────────────────────────
CLAUDE.md
**/CLAUDE.md
.claude/

# ── Environment / secrets ─────────────────────────────────────
.env
.env.local
*.env

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Pipeline data (large / generated) ────────────────────────
# novelty_candidates: intermediate (up to 10 MB for full proteome), regenerated each step 2 run
data/results/*_novelty_candidates.json
# per-target docking hit JSONs: generated by step 7, aggregated in top_hits.json + TSV already
data/results/*_docking_hits.json
# final_targets: committed deliberately after significant runs (keep tracked but not auto-ignored)
data/proteomes/
data/structures/
data/docking/ligands_pdbqt/
data/docking/tranches/
data/docking/*_results/
data/docking/*_receptor.pdbqt
data/docking/*_rigid.pdbqt
data/docking/*_flex.pdbqt
data/docking/*_pocket*_vina.conf
data/docking/*_vina_fixed.conf
data/figures/
# BLAST databases (~50 MB binary index files)
data/blast_db/
# Benchmark intermediates (PDB, PDBQT files)
data/benchmark/
# P2Rank raw prediction outputs
data/p2rank/

# Archive files from cleanup_results.py (can be large)
data/docking/*_archive.tar.gz

# Keep committed: vina configs, result summaries, cleanup records
# run_all_docking.sh: auto-generated with wrong Vina syntax (--ligand_directory), use run_docking.py instead
data/docking/run_all_docking.sh
!data/docking/*_vina.conf
!data/docking/docking_results_summary.tsv
!data/docking/top_hits.json
!data/docking/cleanup_manifest.json
!data/docking/*_scores.json

# ── Logs (keep audit log, ignore verbose run logs) ────────────
logs/*.log
logs/*.flag
logs/*.flag.*
logs/_*.py
# batch_*_compressed.json: full non-hit score dumps, too large to commit
# (scores summarized in top_hits.json + pruned_nonhits.jsonl already)
logs/batch_*_compressed.json
# Keep: audit, campaign summary, hit trend, pruned cache, batch summaries/reports
!logs/pipeline_audit.json
!logs/campaign_summary.json
!logs/hit_trend.jsonl
!logs/pruned_nonhits.jsonl
!logs/batch_*_summary.json
!logs/batch_*_report.txt

# ── Docs (generated — keep final versions) ────────────────────
docs/methods_draft.txt
docs/supplementary_S1_audit.txt

# ── Temp / helper scripts ─────────────────────────────────────
scripts/_*.py
*_vina_fixed.conf
tickdock-campaign-monitor.md

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Tools (large binaries — install locally via setup_wsl.sh) ─
tools/

# ── Duplicate legacy files (use core/ and scripts/ instead) ──
files/
logs/_b7qk46_purge_backup/
logs/b7qk46_gapfill.log

# ── GPU restart: local backups + transient docking temp dirs ──
data/docking/_results_bak/
data/docking/ligands_empty_bak/
logs/_pre_gpu_redock_bak/
*.r4bak
# transient GPU staging/output dirs (auto-created/removed per target)
data/docking/gpu_*/
data/docking/gpuout_*/
data/docking/gc_*/
data/docking/gco_*/
data/docking/val_*/
data/docking/valo_*/
# gpu_screen pause control file (runtime signal, not source)
logs/gpu_screen_control.txt

# ── Runtime state (machine-local, not source; regenerated by tools) ──
logs/campaign_state.json
logs/campaign_control.txt
logs/smiles_cache.json
logs/redock_monitor_state.json
data/docking/chembl_offset_state.json
# AF3/Boltz vs Vina validation scratch (poses + receptor copies, regenerable)
data/docking/af3_compare/

# Pre-remap backups of target JSONs (regenerable)
data/results/*.pre_remap_bak
data/results/*.pre_hostrisk_bak

# Phase 1 intermediates (regenerable)
logs/_pdb_hits.tsv
logs/_pdb_ids.txt
logs/_targets_all.fasta
logs/_missing_host_blast.json
logs/_pilot*
logs/_triage_*
out/pg/

# Private: funding strategy + third-party contact info — never public
grants/
